{
  "name": "lemme",
  "version": "0.1.2",
  "description": "Natural language to shell commands, powered by Claude, OpenAI, or Groq",
  "type": "module",
  "bin": {
    "lemme": "bin/index.js"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "cli",
    "shell",
    "terminal",
    "natural-language",
    "claude",
    "openai",
    "groq"
  ],
  "author": "arii",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ary-na/lemme.git"
  },
  "homepage": "https://github.com/ary-na/lemme#readme",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@google/genai": "^2.5.0",
    "chalk": "^5.6.2",
    "groq-sdk": "^1.2.0",
    "openai": "^6.38.0",
    "ora": "^9.4.0"
  }
}
